# Used by docker-compose.yml only. Copy to .env (never commit it) and replace every value.
# Local development without Docker uses backend/.env and frontend/.env.development instead.

# The database password is placed inside a connection URL, so use URL-safe characters:
#   openssl rand -hex 24
MYSQL_ROOT_PASSWORD=replace-with-a-random-hex-string
MYSQL_PASSWORD=replace-with-another-random-hex-string

# At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Required for the course assistant. The default provider is DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
